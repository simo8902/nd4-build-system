{
    .Compiler = 'ClangCl'
    .CompilerOutputPath = '$BuildRoot$/Release/obj/ND4C'
    .CompilerInputFiles = '$Root$/src/Rendering/Vulkan/Vma/VmaImplementation.cpp'
    .PreBuildDependencies = { 'N4DC_ApplicationConfiguration' }
}
.CompilerOptions = '$ReleaseCCompilerOptions$'
ObjectList('ND4C_C_Release')
{
    .Compiler = 'ClangCl'
    .CompilerOutputPath = '$BuildRoot$/Release/obj/ND4C'
    .CompilerInputFiles = '$VulkanInclude$/Volk/volk.c'
    .PreBuildDependencies = { 'N4DC_ApplicationConfiguration' 'N4DC_Shaders' }
}
Library('ND4C_Release')
{
    .Compiler = 'ClangCl'
    .CompilerOptions = '\"%1\" /c /Fo\"%2\"'
    .CompilerOutputPath = '$BuildRoot$/Release/obj/ND4C_Library'
    .Librarian = '$ClangLibrarian$'
    .LibrarianType = 'msvc'
    .LibrarianOptions = '$LibrarianOptions$'
    .LibrarianOutput = '$BuildRoot$/Release/ND4D.lib'
    .LibrarianAdditionalInputs = { 'ND4C_Cpp_Release' 'ND4C_C_Release' 'ND4C_Vma_Release' }
}

.CompilerOptions = '$RelWithDebInfoCompilerOptions$'
ObjectList('ND4C_Cpp_RelWithDebInfo')
{
    .Compiler = 'ClangCl'
    .CompilerOutputPath = '$BuildRoot$/RelWithDebInfo/obj/ND4C'
    .CompilerInputUnity = 'N4DC_Unity_RelWithDebInfo'
    .PreBuildDependencies = { 'N4DC_ApplicationConfiguration' 'N4DC_Idlc_GpuTypes' 'N4DC_Shaders' }
}
.CompilerOptions = '$RelWithDebInfoCompilerOptions$'
ObjectList('ND4C_Vma_RelWithDebInfo')
{
    .Compiler = 'ClangCl'
    .CompilerOutputPath = '$BuildRoot$/RelWithDebInfo/obj/ND4C'
    .CompilerInputFiles = '$Root$/src/Rendering/Vulkan/Vma/VmaImplementation.cpp'
    .PreBuildDependencies = { 'N4DC_ApplicationConfiguration' }
}
.CompilerOptions = '$RelWithDebInfoCCompilerOptions$'
ObjectList('ND4C_C_RelWithDebInfo')
{
    .Compiler = 'ClangCl'
    .CompilerOutputPath = '$BuildRoot$/RelWithDebInfo/obj/ND4C'
    .CompilerInputFiles = '$VulkanInclude$/Volk/volk.c'
    .PreBuildDependencies = { 'N4DC_ApplicationConfiguration' 'N4DC_Shaders' }
}
Library('ND4C_RelWithDebInfo')
{
    .Compiler = 'ClangCl'
    .CompilerOptions = '\"%1\" /c /Fo\"%2\"'
    .CompilerOutputPath = '$BuildRoot$/RelWithDebInfo/obj/ND4C_Library'
    .Librarian = '$ClangLibrarian$'
    .LibrarianType = 'msvc'
    .LibrarianOptions = '$LibrarianOptions$'
    .LibrarianOutput = '$BuildRoot$/RelWithDebInfo/ND4D.lib'
    .LibrarianAdditionalInputs = { 'ND4C_Cpp_RelWithDebInfo' 'ND4C_C_RelWithDebInfo' 'ND4C_Vma_RelWithDebInfo' }
}

.EditorQtLibrariesDebug = { '$N4DCDebugQtRuntimePrefix$/lib/Qt6Widgets.lib' '$N4DCDebugQtRuntimePrefix$/lib/Qt6Svg.lib' '$N4DCDebugQtRuntimePrefix$/lib/Qt6Concurrent.lib' '$N4DCDebugQtRuntimePrefix$/lib/Qt6Gui.lib' '$N4DCDebugQtRuntimePrefix$/lib/Qt6Core.lib' }
.EditorQtLibrariesRelease = { '$N4DCReleaseQtRuntimePrefix$/lib/Qt6Widgets.lib' '$N4DCReleaseQtRuntimePrefix$/lib/Qt6Svg.lib' '$N4DCReleaseQtRuntimePrefix$/lib/Qt6Concurrent.lib' '$N4DCReleaseQtRuntimePrefix$/lib/Qt6Gui.lib' '$N4DCReleaseQtRuntimePrefix$/lib/Qt6Core.lib' }
.EditorQtLibrariesRelWithDebInfo = { '$N4DCRelWithDebInfoQtRuntimePrefix$/lib/Qt6Widgets.lib' '$N4DCRelWithDebInfoQtRuntimePrefix$/lib/Qt6Svg.lib' '$N4DCRelWithDebInfoQtRuntimePrefix$/lib/Qt6Concurrent.lib' '$N4DCRelWithDebInfoQtRuntimePrefix$/lib/Qt6Gui.lib' '$N4DCRelWithDebInfoQtRuntimePrefix$/lib/Qt6Core.lib' }
.EmptyLibraries = { }
.EditorSystemLibraries = { '$GlfwLib$' '$WindowsSdkLib$/gdi32.lib' '$WindowsSdkLib$/opengl32.lib' '$WindowsSdkLib$/shell32.lib' '$WindowsSdkLib$/user32.lib' '$VulkanLib$' '$VulkanBootstrapLib$' '$WindowsSdkLib$/winhttp.lib' '$WindowsSdkLib$/d3d11.lib' '$WindowsSdkLib$/dxgi.lib' '$WindowsSdkLib$/WinMM.Lib' '$WindowsSdkLib$/DbgHelp.Lib' }
If( .N4DCEnableKtx2 ) {
    .EditorSystemLibraries = .EditorSystemLibraries + { '$KtxLib$' }
}
.EditorTracyLibraries = { }
If( .N4DCEnableTracy ) {
    .EditorTracyLibraries = { '$TracyLib$' }
}
.EditorAsanLibraries = { }
.EmptyAsanLibraries = { }
.EmptyAsanTargets = { }
If( .N4DCEnableASAN ) {
    .EditorAsanLibraries = { '$AsanRuntime$' '$AsanThunk$' }
}

function DefineQtRuntimeDlls( .DeploymentTargetName .OutputRoot .QtPrefix .PreBuildTarget )
{
    Copy('$DeploymentTargetName$_Qt6Core')
    {
        .Source = .QtPrefix + '/bin/Qt6Core.dll'
        .Dest = .OutputRoot + '/Qt6Core.dll'
        .PreBuildDependencies = .PreBuildTarget
    }
    Copy('$DeploymentTargetName$_Qt6Gui')
    {
        .Source = .QtPrefix + '/bin/Qt6Gui.dll'
        .Dest = .OutputRoot + '/Qt6Gui.dll'
        .PreBuildDependencies = .PreBuildTarget
    }
    Copy('$DeploymentTargetName$_Qt6Widgets')
    {
        .Source = .QtPrefix + '/bin/Qt6Widgets.dll'
        .Dest = .OutputRoot + '/Qt6Widgets.dll'
        .PreBuildDependencies = .PreBuildTarget
    }
    Copy('$DeploymentTargetName$_Qt6Svg')
    {
        .Source = .QtPrefix + '/bin/Qt6Svg.dll'
        .Dest = .OutputRoot + '/Qt6Svg.dll'
        .PreBuildDependencies = .PreBuildTarget
    }
    Copy('$DeploymentTargetName$_Qt6Concurrent')
    {
        .Source = .QtPrefix + '/bin/Qt6Concurrent.dll'
        .Dest = .OutputRoot + '/Qt6Concurrent.dll'
        .PreBuildDependencies = .PreBuildTarget
    }
    Alias('$DeploymentTargetName$')
    {
        .Targets = {
            '$DeploymentTargetName$_Qt6Core'
            '$DeploymentTargetName$_Qt6Gui'
            '$DeploymentTargetName$_Qt6Widgets'
            '$DeploymentTargetName$_Qt6Svg'
            '$DeploymentTargetName$_Qt6Concurrent'
        }
    }
}

function DefineEditor( .ConfigName .OutputRoot .QtLibraries .TracyLibraries .AsanLibraries .AsanTargets .UnityName .ConfigCompilerOptions .ConfigLinkerOptions .ConfigQtRuntimePrefix .ConfigLinker .ProjectRoot .VulkanSdkRoot .AsanDllPath .SystemLibraries )
{
    ObjectList('N4Editor_Objects_$ConfigName$')
    {
        .Compiler = 'ClangCl'
        .CompilerOptions = .ConfigCompilerOptions
        .CompilerOutputPath = '$OutputRoot$/obj/N4Editor'
        .CompilerInputUnity = .UnityName
        .PreBuildDependencies = { 'N4DC_ApplicationConfiguration' 'N4DC_EmbeddedIcons' 'N4DC_Idlc_GpuTypes' 'N4DC_Shaders' }
    }
    Executable('N4Editor_Binary_$ConfigName$')
    {
        .Linker = .ConfigLinker
        .LinkerOptions = .ConfigLinkerOptions
        .LinkerType = 'msvc'
        .LinkerLinkObjects = true
        .LinkerOutput = '$OutputRoot$/N4Editor.exe'
        .Libraries = { 'N4Editor_Objects_$ConfigName$' 'ND4C_$ConfigName$' .QtLibraries .SystemLibraries .TracyLibraries .AsanLibraries }
    }
    Copy('N4Editor_Stylesheet_$ConfigName$')
    {
        .Source = .ProjectRoot + '/src/Editor/EditorStyle.qss'
        .Dest = '$OutputRoot$/EditorStyle.qss'
        .PreBuildDependencies = 'N4Editor_Binary_$ConfigName$'
    }
    Copy('N4Editor_ValidationDll_$ConfigName$')
    {
        .Source = .VulkanSdkRoot + '/Bin/VkLayer_khronos_validation.dll'
        .Dest = '$OutputRoot$/VkLayer_khronos_validation.dll'
        .PreBuildDependencies = 'N4Editor_Binary_$ConfigName$'
    }
    Copy('N4Editor_ValidationJson_$ConfigName$')
    {
        .Source = .VulkanSdkRoot + '/Bin/VkLayer_khronos_validation.json'
        .Dest = '$OutputRoot$/VkLayer_khronos_validation.json'
        .PreBuildDependencies = 'N4Editor_Binary_$ConfigName$'
    }
    DefineQtRuntimeDlls('N4Editor_QtDlls_$ConfigName$' .OutputRoot .ConfigQtRuntimePrefix 'N4Editor_Binary_$ConfigName$')
    Copy('N4Editor_QtPlatform_$ConfigName$')
    {
        .Source = .ConfigQtRuntimePrefix + '/plugins/platforms/qwindows.dll'
        .Dest = '$OutputRoot$/platforms/qwindows.dll'
        .PreBuildDependencies = 'N4Editor_Binary_$ConfigName$'
    }
    Alias('N4Editor_$ConfigName$')
    {
        .Targets = { 'N4Editor_Binary_$ConfigName$' 'N4Editor_Stylesheet_$ConfigName$' 'N4Editor_ValidationDll_$ConfigName$' 'N4Editor_ValidationJson_$ConfigName$' 'N4Editor_QtDlls_$ConfigName$' 'N4Editor_QtPlatform_$ConfigName$' .AsanTargets }
    }
}
If( .N4DCEnableASAN ) {
    Copy('N4Editor_AsanDll_Debug')
    {
        .Source = '$AsanDll$'
        .Dest = '$BuildRoot$/Debug/clang_rt.asan_dynamic-x86_64.dll'
    }
    Copy('N4Editor_AsanDll_RelWithDebInfo')
    {
        .Source = '$AsanDll$'
        .Dest = '$BuildRoot$/RelWithDebInfo/clang_rt.asan_dynamic-x86_64.dll'
    }
}


.DebugAsanLibraries = .EmptyAsanLibraries
.RelWithDebInfoAsanLibraries = .EmptyAsanLibraries
.DebugAsanTargets = .EmptyAsanTargets
.RelWithDebInfoAsanTargets = .EmptyAsanTargets
If( .N4DCEnableASAN ) {
    ^DebugAsanLibraries = .EditorAsanLibraries
    ^RelWithDebInfoAsanLibraries = .EditorAsanLibraries
    ^DebugAsanTargets = { 'N4Editor_AsanDll_Debug' }
    ^RelWithDebInfoAsanTargets = { 'N4Editor_AsanDll_RelWithDebInfo' }
}
DefineEditor('Debug' '$BuildRoot$/Debug' .EditorQtLibrariesDebug .EditorTracyLibraries .DebugAsanLibraries .DebugAsanTargets 'N4Editor_Unity_Debug' '$DebugCompilerOptions$' '$DebugLinkerOptions$' .N4DCDebugQtRuntimePrefix .ClangLinker .Root .VulkanSdk .AsanDll .EditorSystemLibraries)
DefineEditor('Release' '$BuildRoot$/Release' .EditorQtLibrariesRelease .EmptyLibraries .EmptyAsanLibraries .EmptyAsanTargets 'N4Editor_Unity_Release' '$ReleaseCompilerOptions$' '$ReleaseLinkerOptions$' .N4DCReleaseQtRuntimePrefix .ClangLinker .Root .VulkanSdk .AsanDll .EditorSystemLibraries)
DefineEditor('RelWithDebInfo' '$BuildRoot$/RelWithDebInfo' .EditorQtLibrariesRelWithDebInfo .EditorTracyLibraries .RelWithDebInfoAsanLibraries .RelWithDebInfoAsanTargets 'N4Editor_Unity_RelWithDebInfo' '$RelWithDebInfoCompilerOptions$' '$RelWithDebInfoLinkerOptions$' .N4DCRelWithDebInfoQtRuntimePrefix .ClangLinker .Root .VulkanSdk .AsanDll .EditorSystemLibraries)

#include "fbuild.optional.bff"

Alias('N4Editor')
{
    .Targets = 'N4Editor_Debug'
}

Alias('all')
{
    .Targets = { 'N4Editor_Debug' 'N4Editor_Release' 'N4Editor_RelWithDebInfo' }
}