    .CommonSourceIncludeFlags = '$CommonSourceIncludeFlags$ /I./libs/KTX-Software/debug/include'
}
.DebugSourceIncludeFlags = '$CommonSourceIncludeFlags$ /I"$N4DCDebugQtRuntimePrefix$/include" /I"$N4DCDebugQtRuntimePrefix$/include/QtCore" /I"$N4DCDebugQtRuntimePrefix$/include/QtGui" /I"$N4DCDebugQtRuntimePrefix$/include/QtWidgets" /I"$N4DCDebugQtRuntimePrefix$/include/QtSvg" /I"$N4DCDebugQtRuntimePrefix$/include/QtConcurrent"'
.ReleaseSourceIncludeFlags = '$CommonSourceIncludeFlags$ /I"$N4DCReleaseQtRuntimePrefix$/include" /I"$N4DCReleaseQtRuntimePrefix$/include/QtCore" /I"$N4DCReleaseQtRuntimePrefix$/include/QtGui" /I"$N4DCReleaseQtRuntimePrefix$/include/QtWidgets" /I"$N4DCReleaseQtRuntimePrefix$/include/QtSvg" /I"$N4DCReleaseQtRuntimePrefix$/include/QtConcurrent"'
.RelWithDebInfoSourceIncludeFlags = '$CommonSourceIncludeFlags$ /I"$N4DCRelWithDebInfoQtRuntimePrefix$/include" /I"$N4DCRelWithDebInfoQtRuntimePrefix$/include/QtCore" /I"$N4DCRelWithDebInfoQtRuntimePrefix$/include/QtGui" /I"$N4DCRelWithDebInfoQtRuntimePrefix$/include/QtWidgets" /I"$N4DCRelWithDebInfoQtRuntimePrefix$/include/QtSvg" /I"$N4DCRelWithDebInfoQtRuntimePrefix$/include/QtConcurrent"'

.CommonDefines = '/DWIN32 /D_WINDOWS /DNOMINMAX /DGLM_FORCE_DEPTH_ZERO_TO_ONE /DGLM_FORCE_RADIANS /DKHRONOS_STATIC /DN4DC_ENABLE_ANIMATIONS=$N4DCEnableAnimationsValue$ /DN4DC_ENABLE_PARTICLES=$N4DCEnableParticlesValue$ /DN4DC_STANDALONE_MODE=$N4DCStandaloneModeValue$ /DN4DC_VULKAN_CHECK=$N4DCVulkanCheckValue$ /DN4DC_DISABLE_LOG_WINDOW=$N4DCDisableLogWindowValue$ /DN4DC_HAS_KTX2=$N4DCHasKtx2Value$ /DVK_NO_PROTOTYPES /DVK_USE_PLATFORM_WIN32_KHR /D_CRT_SECURE_NO_WARNINGS /D_ITERATOR_DEBUG_LEVEL=0 /DSOURCE_DIR=\"$Root$\" /DSHADER_DIR=\"$Root$/shaders\" $N4DCDisableLoggingDefine$'
.DebugDefines = '$CommonDefines$ /DN4DC_DEBUG_BUILD $N4DCDebugAsanDefines$ $N4DCDebugTracyDefines$'
.ReleaseDefines = '$CommonDefines$'
.RelWithDebInfoDefines = '$CommonDefines$ $N4DCRelWithDebInfoAsanDefines$ $N4DCRelWithDebInfoTracyDefines$'
.DebugCompilerOptions = '\"%1\" /nologo /TP $DebugDefines$ /W4 $DebugSourceIncludeFlags$ /GR /EHsc /Zi /Ob0 /Od /RTC1 /std:c++20 /MD $N4DCDebugAsanCompile$ -c /Fo\"%2\"'
.ReleaseCompilerOptions = '\"%1\" /nologo /TP $ReleaseDefines$ -w $ReleaseSourceIncludeFlags$ /GR /EHsc /O2 /Ob3 /Oi /GL /std:c++20 /MD -c /Fo\"%2\"'
.RelWithDebInfoCompilerOptions = '\"%1\" /nologo /TP $RelWithDebInfoDefines$ /W4 $RelWithDebInfoSourceIncludeFlags$ /GR /EHsc /O2 /Ob3 /Oi /GL /Zi /std:c++20 /MD $N4DCRelWithDebInfoAsanCompile$ -c /Fo\"%2\"'
.DebugCCompilerOptions = '\"%1\" /nologo /TC $DebugDefines$ $CommonSourceIncludeFlags$ /Zi /Ob0 /Od /RTC1 /std:c11 /MD $N4DCDebugAsanCompile$ -c /Fo\"%2\"'
.ReleaseCCompilerOptions = '\"%1\" /nologo /TC $ReleaseDefines$ $CommonSourceIncludeFlags$ /O2 /Ob3 /Oi /GL /std:c11 /MD -c /Fo\"%2\"'
.RelWithDebInfoCCompilerOptions = '\"%1\" /nologo /TC $RelWithDebInfoDefines$ $CommonSourceIncludeFlags$ /O2 /Ob3 /Oi /GL /Zi /std:c11 /MD $N4DCRelWithDebInfoAsanCompile$ -c /Fo\"%2\"'
.DebugLinkerOptions = '%1 /nologo /OUT:"%2" /MACHINE:X64 /DEBUG /INCREMENTAL /SUBSYSTEM:CONSOLE /LIBPATH:"$WindowsSdkLib$" /LIBPATH:"$WindowsSdkUcrtLib$" /LIBPATH:"$MsvcLib$" /LIBPATH:"$AsanLinkerLib$"'
.ReleaseLinkerOptions = '%1 /nologo /OUT:"%2" /MACHINE:X64 /DEBUG /OPT:REF /OPT:ICF /LTCG /SUBSYSTEM:CONSOLE /LIBPATH:"$WindowsSdkLib$" /LIBPATH:"$WindowsSdkUcrtLib$" /LIBPATH:"$MsvcLib$" /LIBPATH:"$AsanLinkerLib$"'
.RelWithDebInfoLinkerOptions = '%1 /nologo /OUT:"%2" /MACHINE:X64 /DEBUG /OPT:REF /OPT:ICF /LTCG /SUBSYSTEM:CONSOLE /LIBPATH:"$WindowsSdkLib$" /LIBPATH:"$WindowsSdkUcrtLib$" /LIBPATH:"$MsvcLib$" /LIBPATH:"$AsanLinkerLib$"'
.LibrarianOptions = '/OUT:"%2" %1'

