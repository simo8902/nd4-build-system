.CommonSourceIncludeFlags = '/I. /I./src /I./libs/glm /I./build-fastbuild/generated /I./libs/VULKAN/1.4.341.1/Include /I./libs/VVMemoryAllocator/include /I./libs/VKBootstrap/release/include /I./libs/glfw3.4/include /I./libs/tracy/release/include/tracy'
