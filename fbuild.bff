}

Exec('N4DC_Idlc_GpuTypes')
{
    .ExecExecutable = '$BuildRoot$/tools/idlc/N4DC_Idlc.exe'
    .ExecInput = { '$Root$/schemas/gpu.n4idl' '$Root$/tools/idlc/idlc.cpp' }
    .ExecOutput = '$GeneratedRoot$/n4dc_gpu_types.stamp'
    .ExecArguments = '--input "schemas/gpu.n4idl" --cpp-output "$GeneratedRoot$/N4DCGpuTypes.generated.h" --glsl-output "$GeneratedRoot$/n4dc_gpu_types.glsl" --stamp "%2"'
    .ExecWorkingDir = '$Root$'
    .PreBuildDependencies = 'N4DC_Idlc_Binary'
}

Exec('N4DC_ApplicationConfiguration')
{
    .ExecExecutable = '$Python$'
    .ExecInput = { '$Root$/tools/ApplicationConfiguration.h.in' '$Root$/tools/generate-application-config.py' '$Root$/fbuild.options.bff' }
    .ExecOutput = '$GeneratedRoot$/ApplicationConfiguration.generated.h'
    .ExecArguments = '"tools/generate-application-config.py" --template "tools/ApplicationConfiguration.h.in" --output "%2" --setting "N4DC_APPLICATION_NAME=$N4DCApplicationName$" --setting "N4DC_APPLICATION_VERSION=$N4DCApplicationVersion$" --setting "N4DC_ORGANIZATION_NAME=$N4DCOrganizationName$" --setting "N4DC_MAIN_THREAD_NAME=$N4DCMainThreadName$" --setting "N4DC_SPLASH_IMAGE_FILE_NAME=$N4DCSplashImageFileName$" --setting "N4DC_EDITOR_STYLESHEET_FILE_NAME=$N4DCEditorStylesheetFileName$" --setting "N4DC_SPLASH_DISPLAY_DURATION_MS=$N4DCSplashDisplayDurationMs$" --setting "N4DC_STANDALONE_WINDOW_WIDTH=$N4DCStandaloneWindowWidth$" --setting "N4DC_STANDALONE_WINDOW_HEIGHT=$N4DCStandaloneWindowHeight$" --setting "N4DC_USE_STARTUP_MAP_VALUE=$N4DCUseStartupMapValue$" --setting "N4DC_STARTUP_MAP_ENVIRONMENT_NAME=$N4DCStartupMapEnvironmentName$" --setting "N4DC_STARTUP_MAP_PATH=$N4DCStartupMapPath$" --setting "N4DC_EMPTY_ENVIRONMENT_VALUE=$N4DCEmptyEnvironmentValue$" --setting "N4DC_FALLBACK_STARTUP_MODEL_PATH_1=$N4DCFallbackStartupModelPath1$" --setting "N4DC_FALLBACK_STARTUP_MODEL_PATH_2=$N4DCFallbackStartupModelPath2$" --setting "N4DC_LOOK_EXPOSURE=$N4DCLookExposure$" --setting "N4DC_LOOK_CONTRAST=$N4DCLookContrast$" --setting "N4DC_LOOK_GAMMA=$N4DCLookGamma$" --setting "N4DC_LOOK_SATURATION=$N4DCLookSaturation$" --setting "N4DC_LOOK_BLOOM=$N4DCLookBloom$" --setting "N4DC_LOOK_FOG=$N4DCLookFog$" --setting "N4DC_LOOK_HIGHLIGHT_BOOST=$N4DCLookHighlightBoost$" --setting "N4DC_ENABLE_HDR10_OUTPUT_VALUE=$N4DCEnableHdr10OutputValue$" --setting "N4DC_HDR10_PAPER_WHITE_NITS=$N4DCHdr10PaperWhiteNits$" --setting "N4DC_HDR10_PEAK_NITS=$N4DCHdr10PeakNits$" --setting "N4DC_HDR10_MIN_NITS=$N4DCHdr10MinNits$" --setting "N4DC_HDR10_MAX_FALL_NITS=$N4DCHdr10MaxFallNits$" --setting "N4DC_DISABLE_FRUSTUM_CULLING_VALUE=$N4DCDisableFrustumCullingValue$" --setting "N4DC_DISABLE_FACE_CULLING_VALUE=$N4DCDisableFaceCullingValue$" --setting "N4DC_GPU_CULLING_VALUE=$N4DCGpuCullingValue$" --setting "N4DC_VULKAN_LAYER_FILTER_VALUE=$N4DCVulkanLayerFilterValue$" --setting "N4DC_VULKAN_LAYER_PATH_ENVIRONMENT_NAME=$N4DCVulkanLayerPathEnvironmentName$" --setting "N4DC_VULKAN_VALIDATION_VALUE=$N4DCVulkanValidationValue$" --setting "N4DC_DIRECT_STANDARD_DRAWS_WINDOWS_VALUE=$N4DCDirectStandardDrawsWindowsValue$" --setting "N4DC_DIRECT_STANDARD_DRAWS_NON_WINDOWS_VALUE=$N4DCDirectStandardDrawsNonWindowsValue$" --setting "N4DC_GAME_THREAD_VALUE=$N4DCGameThreadValue$" --setting "N4DC_RENDER_THREAD_VALUE=$N4DCRenderThreadValue$" --setting "N4DC_DISABLE_LOG_WINDOW_VALUE=$N4DCDisableLogWindowValue$" --setting "N4DC_DISABLE_DXGI_PRESENTER_VALUE=$N4DCDisableDxgiPresenterValue$"'
    .ExecWorkingDir = '$Root$'
}

Exec('N4DC_EmbeddedIcons')
{
    .ExecExecutable = '$Python$'
    .ExecInput = { '$Root$/tools/embed_icons.py' '$Root$/src/Editor/icons/icon_map.json' }
    .ExecInputPath = { '$Root$/src/Editor/icons' '$Root$/src/Editor/icons-ue5' }
    .ExecInputPattern = { '*-grey.png' '*-blue.png' '*.svg' }
    .ExecInputPathRecurse = false
    .ExecOutput = '$GeneratedRoot$/icons_embedded.h'
    .ExecArguments = '"tools/embed_icons.py" --map "src/Editor/icons/icon_map.json" --svg-root "src/Editor/icons-ue5" --output "%2"'
    .ExecWorkingDir = '$Root$'
}

Exec('N4DC_Shaders')
{
    .ExecExecutable = '$Python$'
    .ExecInput = { '$Root$/tools/compile-shaders.py' '$Root$/schemas/gpu.n4idl' '$Root$/tools/idlc/idlc.cpp' }
    .ExecInputPath = '$Root$/shaders'
    .ExecInputPattern = { 'shaders.cfg' '*.vert' '*.frag' '*.comp' '*.glsl' }
    .ExecInputPathRecurse = true
    .ExecOutput = '$GeneratedRoot$/shaders.stamp'
    .ExecArguments = '"tools/compile-shaders.py" --config "shaders/shaders.cfg" --root "shaders" --glslang "$Glslang$" --include-root "$GeneratedRoot$" --stamp "%2"'
    .ExecWorkingDir = '$Root$'
    .PreBuildDependencies = 'N4DC_Idlc_GpuTypes'
}

