.N4DCRelWithDebInfoAsanCompile = ''
If( !.N4DCEnableAnimations ) { .N4DCEnableAnimationsValue = '0' }
If( .N4DCEnableParticles ) { .N4DCEnableParticlesValue = '1' }
If( .N4DCStandaloneMode ) { .N4DCStandaloneModeValue = '1' }
If( .N4DCVulkanCheck ) { .N4DCVulkanCheckValue = '1' }
If( !.N4DCDisableLogWindow ) { .N4DCDisableLogWindowValue = '0' }
If( !.N4DCEnableHdr10Output ) { .N4DCEnableHdr10OutputValue = '0' }
If( !.N4DCUseStartupMap ) { .N4DCUseStartupMapValue = '0' }
If( .N4DCEnableKtx2 ) { .N4DCHasKtx2Value = '1' }
If( .N4DCDisableLogging ) { .N4DCDisableLoggingDefine = '/DN4DC_DISABLE_LOGGING' }
If( .N4DCEnableTracy ) {
    .N4DCDebugTracyDefines = '/DTRACY_ENABLE'
    .N4DCRelWithDebInfoTracyDefines = '/DTRACY_ENABLE'
}
If( .N4DCEnableASAN ) {
    .N4DCDebugAsanDefines = '/D_DISABLE_STRING_ANNOTATION /D_DISABLE_VECTOR_ANNOTATION'
    .N4DCRelWithDebInfoAsanDefines = '/D_DISABLE_STRING_ANNOTATION /D_DISABLE_VECTOR_ANNOTATION'
    .N4DCDebugAsanCompile = '/fsanitize=address'
    .N4DCRelWithDebInfoAsanCompile = '/fsanitize=address'
}

